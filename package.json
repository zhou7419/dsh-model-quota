{
  "name": "dsh-model-quota",
  "description": "DSH web plugin: show remaining model quota in the sidebar footer — DeepSeek account balance and Qwen Token Plan credits.",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "quota",
    "balance",
    "token-plan",
    "qianwen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhou7419/dsh-model-quota.git"
  },
  "bugs": {
    "url": "https://github.com/zhou7419/dsh-model-quota/issues"
  },
  "homepage": "https://github.com/zhou7419/dsh-model-quota#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2 || ^0.1.5-rc.1"
  }
}
