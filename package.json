{
  "name": "dsh-model-quota",
  "description": "DSH web plugin: show remaining model quota in the sidebar footer — DeepSeek account balance and Qwen Token Plan credits.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "quota",
    "balance",
    "token-plan",
    "qianwen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhou7419/dsh-model-quota.git"
  },
  "bugs": {
    "url": "https://github.com/zhou7419/dsh-model-quota/issues"
  },
  "homepage": "https://github.com/zhou7419/dsh-model-quota#readme",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2"
  }
}